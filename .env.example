# Required: a Tailscale auth key.
# Create one at https://login.tailscale.com/admin/settings/keys
# Recommended: reusable, non-ephemeral; add tags with TS_EXTRA_ARGS if you use
# an OAuth client key instead.
TS_AUTHKEY=tskey-auth-REPLACE_ME

# Machine name on the tailnet (optional, defaults to paper-explainer)
TS_HOSTNAME=paper-explainer

# Extra flags passed to `tailscale up` (optional).
# The default keeps public DNS so the backend can still fetch arXiv pages.
# TS_EXTRA_ARGS=--accept-dns=false
# For a tagged OAuth client key:
# TS_EXTRA_ARGS=--advertise-tags=tag:server --accept-dns=false

# Logging (optional)
RUST_LOG=paper_explainer=info,tower_http=warn
